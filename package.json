{
  "name": "easy-job",
  "displayName": "Easy Job",
  "version": "1.3.1",
  "private": true,
  "description": "Easy Job，支持岗位筛选、AI 匹配度评估、分段打招呼和投递记录管理。",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox",
    "verify:background-ai": "node scripts/verify-background-ai.mjs",
    "verify:action-gate-coverage": "node scripts/verify-action-gate-coverage.mjs",
    "verify:public-config": "node --test scripts/verify-public-config-paths.test.mjs scripts/verify-public-config-paths.fresh.test.mjs && node scripts/verify-public-config-paths.mjs",
    "verify:greeting-salutation": "node scripts/verify-greeting-salutation.mjs",
    "verify:greeting-chat-delivery": "node scripts/verify-greeting-chat-delivery.mjs",
    "verify:delivery-record-persistence": "node scripts/verify-delivery-record-persistence.mjs",
    "verify:greeting-route": "node scripts/verify-greeting-route.mjs",
    "verify:job-content-filter": "node scripts/verify-job-content-filter.mjs",
    "verify:score-only-filter": "node scripts/verify-score-only-filter.mjs",
    "verify:daily-delivery-safety": "node scripts/verify-daily-delivery-safety.mjs",
    "verify:universal-config": "vitest run src/config src/profile src/background/configService.test.ts src/background/deliveryTaskCoordinator.test.ts src/message/configProtocol.test.ts src/entrypoints/options/App.test.ts",
    "verify:greeting-quality": "vitest run src/utils/greetingQuality.test.ts src/utils/greetingHistory.test.ts src/utils/aiGreetingDraft.test.ts",
    "postinstall": "wxt prepare",
    "check": "vue-tsc --noEmit",
    "build": "run-p build:chrome build:firefox build:edge",
    "build:chrome": "wxt build -b chrome && node scripts/validate-extension.mjs .output/chrome-mv3 chrome",
    "build:firefox": "wxt build -b firefox && node scripts/validate-extension.mjs .output/firefox-mv3 firefox",
    "build:edge": "wxt build -b edge && node scripts/validate-extension.mjs .output/edge-mv3 edge",
    "validate:chrome": "node scripts/validate-extension.mjs .output/chrome-mv3 chrome",
    "zip": "run-p zip:chrome zip:firefox zip:edge",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:firefox": "node scripts/validate-extension.mjs .output/firefox-mv3 firefox",
    "validate:edge": "node scripts/validate-extension.mjs .output/edge-mv3 edge",
    "validate": "run-s validate:chrome validate:firefox validate:edge"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "clsx": "2.1.1",
    "comctx": "^1.4.3",
    "fetch-event-stream": "^0.1.6",
    "lucide-vue-next": "1.0.0",
    "mitem": "^1.0.10",
    "partial-json": "^0.1.7",
    "pinia": "^3.0.4",
    "reka-ui": "2.10.1",
    "tailwind-merge": "3.6.0",
    "vue": "^3.5.26",
    "vue-virtual-scroller": "2.0.0-beta.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.2",
    "@types/chrome": "^0.0.301",
    "@types/node": "^20.19.27",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.2",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "^0.5.1",
    "@vueuse/core": "^14.1.0",
    "@wxt-dev/module-vue": "^1.0.3",
    "jiti": "2.7.0",
    "jsdom": "29.1.1",
    "lint-staged": "^16.3.3",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.38.0",
    "oxlint": "^1.53.0",
    "oxlint-tsgolint": "^0.16.0",
    "proto2api": "^0.0.8",
    "protobufjs": "^7.5.4",
    "sass": "^1.97.1",
    "tailwindcss": "4.3.2",
    "ts-proto": "^1.181.2",
    "typescript": "^5.9.3",
    "uid": "^2.0.2",
    "vitest": "4.1.9",
    "vue-tsc": "^3.2.1",
    "wxt": "^0.20.13"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint --fix"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee",
  "pnpm": {
    "overrides": {
      "form-data": "4.0.6",
      "postcss": "8.5.18"
    }
  }
}
